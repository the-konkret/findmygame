{
  "name": "findmygame",
  "version": "0.4.0",
  "private": true,
  "description": "Search video games, check discounts, keep favourites and notes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean:results": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "test": "npm run clean:results && playwright test",
    "test:live": "npm run clean:results && cross-env BASE_URL=https://findmygame.mktestbb.workers.dev playwright test",
    "test:ui": "playwright test --ui",
    "report": "allure generate allure-results && allure open allure-report"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "allure": "^3.0.0-beta.1",
    "allure-playwright": "^3.3.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}

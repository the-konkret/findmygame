// Cloudflare Worker settings. "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "findmygame",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // The built website (output of `npm run build`).
    "directory": "./dist/",
    // Unknown paths like /game/3328 get index.html, and React takes it from there.
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Only /api/... requests run the Worker code; everything else is served as plain files.
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare's AI models, for the "Describe a game" search (free daily allowance on the free plan).
  "ai": { "binding": "AI" },
  // Price check for everyone's price alerts, every 3 hours (times in UTC). See worker/priceCheck.ts.
  "triggers": { "crons": ["0 */3 * * *"] },
  // Plain settings (not secret). The secret key goes in the Cloudflare dashboard, never here.
  "vars": { "SUPABASE_URL": "https://rmbswrzxmefxoimriiny.supabase.co" },
  "observability": { "enabled": true }
}
